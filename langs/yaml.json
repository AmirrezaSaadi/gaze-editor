{
  "schema": 1,
  "id": "yaml",
  "name": "YAML",
  "extensions": [
    "yaml",
    "yml"
  ],
  "filenames": [],
  "line_comment": [
    "#"
  ],
  "block_comment": [],
  "strings": [
    {
      "start": "\"",
      "end": "\"",
      "escape": "\\"
    },
    {
      "start": "'",
      "end": "'"
    }
  ],
  "keywords": [
    "true",
    "false",
    "null",
    "yes",
    "no",
    "on",
    "off"
  ],
  "types": [],
  "builtins": [],
  "numbers": true,
  "line_rules": [
    {
      "pattern": "^[A-Za-z0-9_.-]+:",
      "class": "type"
    },
    {
      "pattern": "^- ",
      "class": "keyword"
    }
  ]
}
