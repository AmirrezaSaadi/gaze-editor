{
  "schema": 1,
  "id": "typescript",
  "name": "TypeScript",
  "extensions": [
    "ts",
    "tsx",
    "mts",
    "cts"
  ],
  "filenames": [],
  "line_comment": [
    "//"
  ],
  "block_comment": [
    {
      "start": "/*",
      "end": "*/"
    }
  ],
  "strings": [
    {
      "start": "\"",
      "end": "\"",
      "escape": "\\"
    },
    {
      "start": "'",
      "end": "'",
      "escape": "\\"
    },
    {
      "start": "`",
      "end": "`",
      "escape": "\\",
      "multiline": true
    }
  ],
  "keywords": [
    "abstract",
    "any",
    "as",
    "assert",
    "async",
    "await",
    "break",
    "case",
    "catch",
    "class",
    "const",
    "constructor",
    "continue",
    "declare",
    "default",
    "delete",
    "do",
    "else",
    "enum",
    "export",
    "extends",
    "finally",
    "for",
    "from",
    "function",
    "get",
    "if",
    "implements",
    "import",
    "in",
    "infer",
    "instanceof",
    "interface",
    "is",
    "keyof",
    "let",
    "namespace",
    "new",
    "of",
    "private",
    "protected",
    "public",
    "readonly",
    "return",
    "satisfies",
    "set",
    "static",
    "super",
    "switch",
    "this",
    "throw",
    "try",
    "type",
    "typeof",
    "unique",
    "var",
    "void",
    "while",
    "yield"
  ],
  "types": [
    "boolean",
    "number",
    "string",
    "symbol",
    "unknown",
    "never",
    "object",
    "bigint",
    "Array",
    "Record",
    "Partial",
    "Readonly",
    "Promise"
  ],
  "builtins": [
    "console",
    "document",
    "JSON",
    "Math",
    "Object",
    "Promise",
    "Reflect",
    "String",
    "Number",
    "Boolean",
    "Date",
    "RegExp",
    "Error",
    "Map",
    "Set",
    "WeakMap",
    "process",
    "require",
    "window"
  ],
  "numbers": true,
  "line_rules": []
}
