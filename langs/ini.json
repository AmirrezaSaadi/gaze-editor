{
  "schema": 1,
  "id": "ini",
  "name": "INI / conf",
  "extensions": [
    "ini",
    "conf",
    "cfg",
    "properties",
    "desktop",
    "service",
    "env"
  ],
  "filenames": [],
  "line_comment": [
    ";",
    "#"
  ],
  "block_comment": [],
  "strings": [
    {
      "start": "\"",
      "end": "\""
    },
    {
      "start": "'",
      "end": "'"
    }
  ],
  "keywords": [
    "true",
    "false",
    "yes",
    "no",
    "on",
    "off"
  ],
  "types": [],
  "builtins": [],
  "numbers": true,
  "line_rules": [
    {
      "pattern": "^\\[[^\\]]*\\]",
      "class": "type"
    },
    {
      "pattern": "^[^=:\\s][^=:]*[=:]",
      "class": "keyword"
    }
  ]
}
